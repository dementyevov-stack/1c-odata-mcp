// Синтетический прототип контракта. НЕ КОМПИЛИРОВАЛСЯ и НЕ ИСПОЛЬЗОВАЛСЯ
// на живой базе. Псевдоним имён движения/субконто нужно сверить с целевой
// конфигурацией; прототип не является установочным комплектом 1С:Фреш.
//
// Контракт: одна шапка ОперацияБух + набор записей Хозрасчетный одного
// регистратора. Posted и Active переносятся как есть, пустые суммы/ссылки
// не заполняются значениями по умолчанию.

Функция СведенияОВнешнейОбработке() Экспорт
    ПараметрыРегистрации = Новый Структура;
    ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
    ПараметрыРегистрации.Вставить("Наименование", "Синтетическая миграция ручной операции");
    ПараметрыРегистрации.Вставить("Версия", "0.1.0");
    ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
    ПараметрыРегистрации.Вставить("Информация", "Только тестовый контур; без сети и внешних компонент.");
    Команды = Новый Массив;
    Команда = Новый Структура;
    Команда.Вставить("Представление", "Перенести ручную операцию");
    Команда.Вставить("Идентификатор", "migration.manual-operation");
    Команда.Вставить("Использование", "СерверныйВызов");
    Команда.Вставить("МодифицируетДанные", Истина);
    Команды.Добавить(Команда);
    ПараметрыРегистрации.Вставить("Команды", Команды);
    Возврат ПараметрыРегистрации;
КонецФункции

Функция ВыполнитьМиграцию(Шапка, Движения, КлючПовторяемости) Экспорт
    // Все проверки и запись — в одной транзакции. При любом расхождении
    // readback или ссылки — ОтменитьТранзакцию, частичных данных не остаётся.
    НачатьТранзакцию();
    Попытка
        Существующий = НайтиДокументПоКлючу(КлючПовторяемости, Шапка.Организация, Шапка.Дата);
        Если Существующий <> Неопределено Тогда
            ПрочитатьИСверить(Существующий, Шапка, Движения);
            ЗафиксироватьТранзакцию();
            Возврат Существующий;
        КонецЕсли;

        ПроверитьШапкуИДвижения(Шапка, Движения);
        Документ = ЗаписатьШапкуИДвижения(Шапка, Движения, КлючПовторяемости);
        ПрочитатьИСверить(Документ, Шапка, Движения);
        ЗафиксироватьТранзакцию();
        Возврат Документ;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура ПроверитьШапкуИДвижения(Шапка, Движения)
    Если Движения.Количество() = 0 Тогда
        ВызватьИсключение "Нужен хотя бы один набор движений.";
    КонецЕсли;
    Для Каждого Строка Из Движения Цикл
        ПроверитьСсылкуИВид(Строка.СчетДт, "ПланСчетов.Хозрасчетный");
        ПроверитьСсылкуИВид(Строка.СчетКт, "ПланСчетов.Хозрасчетный");
        Для Индекс = 1 По 3 Цикл
            ПроверитьСубконто(Строка, "СубконтоДт" + Индекс);
            ПроверитьСубконто(Строка, "СубконтоКт" + Индекс);
        КонецЦикла;
        Если Строка.Активность = Неопределено Тогда
            ВызватьИсключение "Active должен быть задан явно.";
        КонецЕсли;
        // Пустые налоговые суммы не заменяем нулём: если поле не задано —
        // оставляем пустым; если задано — сверяем точное значение.
    КонецЦикла;
КонецПроцедуры

Функция ЗаписатьШапкуИДвижения(Шапка, Движения, КлючПовторяемости)
    Документ = Документы.ОперацияБух.СоздатьДокумент();
    ЗаполнитьЗначенияСвойств(Документ, Шапка);
    Документ.Проведен = Ложь;
    Документ.Комментарий = "[migration:" + КлючПовторяемости + "] " + Шапка.Комментарий;
    Документ.Записать(РежимЗаписиДокумента.Запись);
    // В целевой конфигурации проверить штатный объектный API для набора
    // движений. Прямая запись в таблицы БД запрещена; никакого fallback нет.
    ЗаписатьДвиженияДокумента(Документ, Движения);
    Возврат Документ;
КонецФункции

Процедура ЗаписатьДвиженияДокумента(Документ, Движения)
    // TODO(owner): подтвердить наличие и семантику табличной части проводок
    // у ОперацияБух / штатного API. Если API отсутствует — обработка обязана
    // остановиться до записи, а не писать регистр напрямую.
    ВызватьИсключение "Требуется подтверждение штатного API движений для целевой конфигурации.";
КонецПроцедуры

Функция НайтиДокументПоКлючу(Ключ, Организация, Дата)
    Отбор = Новый Структура("Организация", Организация);
    // В прототипе — только контракт; реальный поиск должен быть ограничен
    // организацией/годом и точным маркером, без полного перебора базы.
    Возврат Неопределено;
КонецФункции

Процедура ПрочитатьИСверить(Документ, Шапка, Движения)
    // Re-read within the transaction and compare every supplied field,
    // including Posted=false, Active per row and typed subconto.
    ВызватьИсключение "Readback-контракт должен быть реализован до установки.";
КонецПроцедуры

Процедура ПроверитьСсылкуИВид(Ссылка, ОжидаемыйТип)
    Если Ссылка = Неопределено Или Ссылка.Пустая() Тогда
        Возврат;
    КонецЕсли;
    Если Ссылка.Метаданные().ПолноеИмя() <> ОжидаемыйТип Тогда
        ВызватьИсключение "Тип ссылки не совпадает: " + Ссылка.Метаданные().ПолноеИмя();
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСубконто(Строка, Имя)
    Значение = Строка[Имя];
    Вид = Строка[Имя + "_Type"];
    Если Значение = Неопределено Или Значение.Пустая() Тогда
        Если Вид <> Неопределено И Вид <> "" Тогда
            ВызватьИсключение "Вид субконто без ссылки: " + Имя;
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Если Вид = Неопределено Или Вид = "" Тогда
        ВызватьИсключение "Ссылка субконто без вида: " + Имя;
    КонецЕсли;
    Если Значение.Метаданные().ПолноеИмя() <> Вид Тогда
        ВызватьИсключение "Тип субконто не совпадает: " + Имя;
    КонецЕсли;
КонецПроцедуры
